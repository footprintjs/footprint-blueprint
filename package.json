{
  "name": "footprint-blueprint",
  "version": "1.0.0",
  "description": "TypeScript platform modules for scoped tenant profiles, feature configuration, adapter routing and action execution with retained evidence.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./features": {
      "types": "./dist/features/index.d.ts",
      "import": "./dist/features/index.js",
      "default": "./dist/features/index.js"
    },
    "./tenancy": {
      "types": "./dist/tenancy/index.d.ts",
      "import": "./dist/tenancy/index.js",
      "default": "./dist/tenancy/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "default": "./dist/adapters/index.js"
    },
    "./seed": {
      "types": "./dist/seed/index.d.ts",
      "import": "./dist/seed/index.js",
      "default": "./dist/seed/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "import": "./dist/actions/index.js",
      "default": "./dist/actions/index.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "import": "./dist/platform/index.js",
      "default": "./dist/platform/index.js"
    },
    "./evidence": {
      "types": "./dist/actions/evidence.d.ts",
      "import": "./dist/actions/evidence.js",
      "default": "./dist/actions/evidence.js"
    },
    "./actions/evidence": {
      "types": "./dist/actions/evidence.d.ts",
      "import": "./dist/actions/evidence.js",
      "default": "./dist/actions/evidence.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics/index.d.ts",
      "import": "./dist/diagnostics/index.js",
      "default": "./dist/diagnostics/index.js"
    },
    "./diagnostics/runtime": {
      "types": "./dist/diagnostics/runtime.d.ts",
      "import": "./dist/diagnostics/runtime.js",
      "default": "./dist/diagnostics/runtime.js"
    },
    "./diagnostics/cause": {
      "types": "./dist/diagnostics/cause.d.ts",
      "import": "./dist/diagnostics/cause.js",
      "default": "./dist/diagnostics/cause.js"
    },
    "./records/object-store": {
      "types": "./dist/records/object-store.d.ts",
      "import": "./dist/records/object-store.js",
      "default": "./dist/records/object-store.js"
    },
    "./diagnostics/coverage": {
      "types": "./dist/diagnostics/coverage.d.ts",
      "import": "./dist/diagnostics/coverage.js",
      "default": "./dist/diagnostics/coverage.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "test:release": "node --test scripts/release-contract.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "footprintjs": "12.0.0",
    "foottrace": "1.15.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@12.11.2",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/footprintjs/footprint-blueprint.git"
  },
  "homepage": "https://github.com/footprintjs/footprint-blueprint#readme",
  "bugs": {
    "url": "https://github.com/footprintjs/footprint-blueprint/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "typescript",
    "multi-tenant",
    "feature-modules",
    "configuration",
    "adapter-pattern",
    "action-registry",
    "execution-provenance",
    "footprintjs"
  ]
}
