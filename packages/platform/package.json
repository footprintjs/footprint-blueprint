{
  "name": "@footprint/platform",
  "version": "0.1.0",
  "description": "Orchestration layer — single entry point to create a fully configured platform instance",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@footprint/features": "workspace:*",
    "@footprint/tenancy": "workspace:*",
    "@footprint/seed": "workspace:*",
    "@footprint/adapters": "workspace:*",
    "@footprint/actions": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "fast-check": "^3.23.0"
  }
}
